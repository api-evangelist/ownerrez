{
  "opencollection": "1.0.0",
  "info": {
    "name": "OwnerRez API v2 Bookings Users API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve the current user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ownerrez.com/v2/users/me"
          },
          "docs": "Returns the account/user context for the authenticated token."
        }
      ]
    }
  ],
  "bundled": true
}