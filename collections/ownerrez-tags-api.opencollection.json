{
  "opencollection": "1.0.0",
  "info": {
    "name": "OwnerRez API v2 Bookings Tags API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List tag values",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ownerrez.com/v2/tags",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to return per page."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of items to skip for pagination."
              }
            ]
          },
          "docs": "Returns tag values applied to records."
        },
        {
          "info": {
            "name": "Apply a tag",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ownerrez.com/v2/tags",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Applies a tag to a record."
        },
        {
          "info": {
            "name": "Retrieve a tag value",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ownerrez.com/v2/tags/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the resource."
              }
            ]
          },
          "docs": "Retrieves a single tag value by identifier."
        },
        {
          "info": {
            "name": "Delete a tag value",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.ownerrez.com/v2/tags/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the resource."
              }
            ]
          },
          "docs": "Removes a tag value from a record."
        },
        {
          "info": {
            "name": "Delete a tag by name",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.ownerrez.com/v2/tags/byname",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "query"
              },
              {
                "name": "entity_id",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Removes a tag from a record by tag name supplied as query parameters."
        }
      ]
    }
  ],
  "bundled": true
}