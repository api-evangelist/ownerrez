{
  "info": {
    "name": "OwnerRez API v2",
    "description": "REST/JSON API for the OwnerRez vacation-rental and short-term-rental property management platform. Base URL: https://api.ownerrez.com/v2. Authenticate with an OAuth 2.0 access token or an API key / Personal Access Token supplied as the username in HTTP Basic auth (blank password). The API is rate limited to 300 requests per 5 minutes per IP. Endpoint paths and methods are grounded in https://api.ownerrez.com/help/v2/index.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{apiKey}}", "type": "string" },
      { "key": "password", "value": "", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api.ownerrez.com/v2", "type": "string" },
    { "key": "apiKey", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Bookings",
      "item": [
        {
          "name": "List bookings",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/bookings?property_ids=1&from=2026-01-01&to=2026-12-31", "host": ["{{baseUrl}}"], "path": ["bookings"], "query": [{ "key": "property_ids", "value": "1" }, { "key": "from", "value": "2026-01-01" }, { "key": "to", "value": "2026-12-31" }] },
            "description": "Returns a paginated list of bookings, filterable by property and arrival window."
          }
        },
        {
          "name": "Create a booking",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"property_id\": 1,\n  \"guest_id\": 100,\n  \"arrival\": \"2026-08-01\",\n  \"departure\": \"2026-08-07\",\n  \"adults\": 2\n}" },
            "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] },
            "description": "Creates a new booking."
          }
        },
        {
          "name": "Retrieve a booking",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/bookings/:id", "host": ["{{baseUrl}}"], "path": ["bookings", ":id"], "variable": [{ "key": "id", "value": "1" }] },
            "description": "Retrieves a single booking by ID."
          }
        },
        {
          "name": "Update a booking",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"notes\": \"Early check-in requested\"\n}" },
            "url": { "raw": "{{baseUrl}}/bookings/:id", "host": ["{{baseUrl}}"], "path": ["bookings", ":id"], "variable": [{ "key": "id", "value": "1" }] },
            "description": "Partially updates an existing booking."
          }
        }
      ]
    },
